# IoTYK Backend Configuration
# ---------------------------

# Node.js Server Settings
NODE_ENV=production
PORT=3000
AES_KEY=             # A random 32-character string for encrypting/decrypting MQTT passwords
JWT_SECRET=          # A random secret for signing JWT tokens
JWT_EXPIRES_IN=7d
FACTORY_API_KEY=     # A secret key to access the Factory Admin Dashboard

# Database (PostgreSQL / Supabase)
DATABASE_URL=        # postgres://[user]:[password]@[host]:[port]/[db_name]

# Supabase Auth/Client Configuration (Optional if using direct PG connection)
SUPABASE_URL=        # https://[project_ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY= # Service role key for admin tasks (if using supabase-js)

# EMQX Cloud / Broker Configuration
EMQX_API_URL=        # https://[emqx_cloud_api_endpoint]/api/v5
EMQX_APP_ID=         # API Key Name from EMQX Cloud
EMQX_APP_SECRET=     # API Key Secret from EMQX Cloud
EMQX_AUTH_ID=        # The Auth source ID in EMQX (e.g. "authenticator1")
EMQX_BROKER_URL=     # mqtts://[your_broker].emqxsl.com:8883
EMQX_MQTT_HOST=      # [your_broker].emqxsl.com (for firmware config)

# EMQX CA Certificate — auto-embedded in all firmware ZIP downloads
# Paste full PEM content of emqxsl-ca.crt (from EMQX Cloud → Connection Guide → Download CA)
EMQX_MQTT_CA_CERT=   # -----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----

# MQTT Bridge Credentials (Admin user for monitoring device status)
MQTT_SERVICE_USER=   # An MQTT user with permissions to subscribe to all device events ($events/#)
MQTT_SERVICE_PASS=   # Password for the bridge user
