# IoTYK Server Configuration
# Copy this file to .env and fill in your values

# ===== SERVER =====
PORT=3000
NODE_ENV=development

# ===== DATABASE =====
# Path to SQLite database file
DB_PATH=./iotyk.db

# ===== JWT AUTHENTICATION =====
# Secret key for signing JWT tokens (use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ===== EMQX MQTT BROKER =====
# EMQX broker details
EMQX_BROKER=your-emqx-broker.com
EMQX_PORT=8883

# EMQX API credentials (for server to connect as admin)
EMQX_API_USER=your-emqx-admin-user
EMQX_API_PASS=your-emqx-admin-password

# ===== EXAMPLE SETUP =====
# For local EMQX development:
# EMQX_BROKER=localhost
# EMQX_PORT=8883
# EMQX_API_USER=admin
# EMQX_API_PASS=public
