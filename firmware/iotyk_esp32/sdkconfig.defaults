# ESP-IDF Configuration Defaults for IoTYK Firmware

# Enable Bluetooth Controller
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=n

# Select NimBLE as the primary BLE Stack (Microscopic Flash & RAM Footprint)
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Use Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Optimize Binary Code Size for Performance & Flash Space
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_LTO_SIZE=y

# Support Secure HTTP Connection buffers and Websockets
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512

# Physical Flash Size Configuration (Set to 4MB for ESP32 Dev Kit)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
